<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp"
    android:background="@drawable/widget_v392_next_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="BACKLOT  /  NEXT" android:textColor="#EEA6B8"
        android:textSize="10sp" android:textStyle="bold"/>
    <TextView android:id="@+id/v392_next_time" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="9dp"
        android:text="All clear" android:textColor="#FFF4EC"
        android:textSize="23sp" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/v392_next_source" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:textColor="#DDC4D2"
        android:textSize="12sp" android:maxLines="2"
        android:text="No upcoming reminder"/>
    <TextView android:id="@+id/v392_next_open" android:layout_width="match_parent"
        android:layout_height="35dp" android:gravity="center"
        android:background="@drawable/widget_v392_button"
        android:text="VIEW REMINDERS" android:textColor="#FFFFFF"
        android:textSize="11sp" android:textStyle="bold"
        android:contentDescription="Open upcoming reminders"/>
</LinearLayout>