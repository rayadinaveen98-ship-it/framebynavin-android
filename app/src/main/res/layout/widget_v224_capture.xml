<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/widget_v224_surface">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="BACKLOT  /  CAPTURE" android:textColor="#FF9FAD"
        android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.10"/>
    <TextView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical"
        android:text="A thought worth keeping?" android:maxLines="2" android:ellipsize="end"
        android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/v224_capture_idea" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center" android:background="@drawable/widget_v224_primary"
            android:text="+ IDEA" android:textSize="12sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:contentDescription="Capture a text or voice idea"/>
        <TextView android:id="@+id/v224_capture_project" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:layout_marginStart="9dp" android:gravity="center"
            android:background="@drawable/widget_v224_secondary"
            android:text="+ PROJECT" android:textSize="12sp" android:textStyle="bold"
            android:textColor="#FFFFFF" android:contentDescription="Create a new project"/>
    </LinearLayout>
</LinearLayout>
