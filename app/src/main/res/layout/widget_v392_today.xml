<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_v392_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="110dp"
    android:padding="12dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_v392_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="BACKLOT · TODAY" android:textAllCaps="true" android:textColor="#E1B379"
            android:textSize="10sp" android:textStyle="bold" android:letterSpacing=".14"
            android:includeFontPadding="false"/>
        <TextView android:id="@+id/widget_v392_today_refresh" android:layout_width="42dp" android:layout_height="42dp"
            android:gravity="center" android:text="↻" android:textSize="22sp" android:textColor="#F5C8CF"
            android:contentDescription="Refresh this Backlot widget"/>
    </LinearLayout>
    
    <TextView android:id="@+id/widget_v392_today_creator" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading your projects" android:textSize="16sp" android:textColor="#FFF0E8" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_marginTop="2dp"/>
    <TextView android:id="@+id/widget_v392_today_personal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Checking personal reminders" android:textSize="13sp" android:textColor="#E8CCD3" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp"/>
    <TextView android:id="@+id/widget_v392_today_upcoming" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Upcoming reminders today" android:textSize="11sp" android:textColor="#C9A8B4" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"/>
</LinearLayout>