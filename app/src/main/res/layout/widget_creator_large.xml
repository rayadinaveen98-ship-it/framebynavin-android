<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_creator_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/widget_large_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FRAMEBYNAVIN"
            android:textColor="#E53935"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:id="@+id/widget_large_today_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#C6A76B"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_large_project_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_large_project"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#F5F2EA"
            android:textSize="20sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_large_stage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#A7A4A0"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/widget_large_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#C6A76B"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_large_reminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@drawable/widget_creator_button"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#F5F2EA"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_large_idea"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="7dp"
            android:gravity="center"
            android:background="@drawable/widget_creator_button_red"
            android:text="+ IDEA"
            android:textColor="#FFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_large_project_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="7dp"
            android:gravity="center"
            android:background="@drawable/widget_creator_button"
            android:text="+ PROJECT"
            android:textColor="#F5F2EA"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_large_release"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/widget_creator_button"
            android:text="RELEASE"
            android:textColor="#F5F2EA"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
