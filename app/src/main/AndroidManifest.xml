<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <application
        android:name=".BacklotRecoveryApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backlot_no_system_backup_legacy"
        android:dataExtractionRules="@xml/backlot_no_system_backup"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/backlot_v198_launcher"
        android:roundIcon="@mipmap/backlot_v198_launcher"
        android:label="Backlot"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrameByNavin">

        <service android:name=".reminders.AlarmRingingService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name=".reminders.VoiceReminderService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <!-- Dedicated Personal audio. No creator TaskStore or full-screen intent. -->
        <service android:name=".personal.PersonalPlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <activity android:name=".personal.PersonalAlertActivity" android:excludeFromRecents="true" android:exported="false" android:launchMode="singleTop" android:theme="@style/Theme.FrameByNavin" />

        <activity android:name=".reminders.AlarmActivity" android:excludeFromRecents="true" android:exported="false" android:launchMode="standard" android:showWhenLocked="true" android:turnScreenOn="true" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".reminders.VoiceReminderActivity" android:excludeFromRecents="true" android:exported="false" android:launchMode="standard" android:showWhenLocked="true" android:turnScreenOn="true" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.BackupActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.PersonalBackupActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.V392WidgetGalleryActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.FreshStartActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.V269DataPrivacyActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.RecoveryCopiesActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.ContentWorkspaceActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".cloud.CloudSyncActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".widget.QuickIdeaActivity" android:exported="false" android:excludeFromRecents="true" android:theme="@style/Theme.FrameByNavin" />

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <!-- V223.1 Personal domain: separate non-exported PendingIntent targets. -->
        <receiver android:name=".personal.PersonalReminderReceiver" android:exported="false" />
        <receiver android:name=".personal.Phase1HabitAlarmReceiver" android:exported="false" />
        <receiver android:name=".personal.Phase1HabitSnoozeReceiver" android:exported="false" />
        <service android:name=".personal.Phase1HabitVoiceService"
            android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <receiver android:name=".personal.PersonalReminderActionReceiver" android:exported="false" />
        <receiver android:name=".reminders.EscalationReceiver" android:exported="false" />
        <receiver android:name=".reminders.ReminderActionReceiver" android:exported="false" />
        <receiver android:name=".reminders.V205NudgePauseReceiver" android:exported="false" />
        <receiver android:name=".reminders.IdeaReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.IdeaReminderActionReceiver" android:exported="false" />
        <receiver android:name=".reminders.ReminderRecoveryReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>


        <!-- All 12 V224 / legacy widgets are retired. Only this new V392 family
             is exposed in the Android launcher picker. No user data is migrated. -->
        <receiver android:name=".widget.V392TodayHubWidgetProvider"
            android:exported="false" android:label="Backlot Today Hub">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_v392_today_hub_info" />
        </receiver>
        <receiver android:name=".widget.V392NextReminderWidgetProvider"
            android:exported="false" android:label="Backlot Next Reminder">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_v392_next_reminder_info" />
        </receiver>
        <receiver android:name=".widget.V392ChallengePulseWidgetProvider"
            android:exported="false" android:label="Backlot Challenge Pulse">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_v392_challenge_pulse_info" />
        </receiver>

        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.FrameByNavin.Starting" />

        <!-- Backlot launcher identity. Exactly one alias is enabled at first install. -->
        <activity-alias
            android:name=".launcher.BacklotCinematicAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/backlot_v198_launcher"
            android:label="Backlot"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.BacklotMinimalAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/backlot_v198_launcher"
            android:label="Backlot"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.BacklotLightAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/backlot_v198_launcher"
            android:label="Backlot"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".launcher.BacklotHorizontalAlias"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/backlot_v198_launcher"
            android:label="Backlot"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
