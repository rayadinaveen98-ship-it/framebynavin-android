<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/ic_framebynavin_launcher"
        android:roundIcon="@drawable/ic_framebynavin_launcher"
        android:label="FrameByNavin"
        android:supportsRtl="true"
        android:theme="@style/Theme.FrameByNavin">

        <service android:name=".reminders.AlarmRingingService" android:exported="false" android:foregroundServiceType="mediaPlayback" />
        <service android:name=".reminders.VoiceReminderService" android:exported="false" android:foregroundServiceType="mediaPlayback" />

        <activity android:name=".reminders.AlarmActivity" android:excludeFromRecents="true" android:exported="false" android:launchMode="standard" android:showWhenLocked="true" android:turnScreenOn="true" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".reminders.VoiceReminderActivity" android:excludeFromRecents="true" android:exported="false" android:launchMode="standard" android:showWhenLocked="true" android:turnScreenOn="true" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.BackupActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.RecoveryCopiesActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".ui.ContentWorkspaceActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".cloud.CloudSyncActivity" android:exported="false" android:theme="@style/Theme.FrameByNavin" />
        <activity android:name=".widget.QuickIdeaActivity" android:exported="false" android:excludeFromRecents="true" android:theme="@style/Theme.FrameByNavin" />

        <receiver android:name=".reminders.ReminderReceiver" android:exported="false" />
        <receiver android:name=".reminders.EscalationReceiver" android:exported="false" />
        <receiver android:name=".reminders.ReminderActionReceiver" android:exported="false" />
        <receiver android:name=".reminders.ReminderRecoveryReceiver" android:enabled="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".widget.CreatorCompactWidgetProvider" android:exported="false" android:label="FrameByNavin Compact">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_creator_compact_info" />
        </receiver>
        <receiver android:name=".widget.CreatorLargeWidgetProvider" android:exported="false" android:label="FrameByNavin Creator Desk">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_creator_large_info" />
        </receiver>
        <receiver android:name=".widget.QuickIdeaWidgetProvider" android:exported="false" android:label="FrameByNavin Quick Idea">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_quick_idea_info" />
        </receiver>
        <receiver android:name=".widget.NewProjectWidgetProvider" android:exported="false" android:label="FrameByNavin New Project">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_new_project_info" />
        </receiver>
        <receiver android:name=".widget.CurrentProjectWidgetProvider" android:exported="false" android:label="FrameByNavin Current Project">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_current_project_info" />
        </receiver>
        <receiver android:name=".widget.NextReminderWidgetProvider" android:exported="false" android:label="FrameByNavin Next Reminder">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_next_reminder_info" />
        </receiver>
        <receiver android:name=".widget.ContentCalendarWidgetProvider" android:exported="false" android:label="FrameByNavin Content Calendar">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendar_info" />
        </receiver>
        <receiver android:name=".widget.DailyBriefWidgetProvider" android:exported="false" android:label="FrameByNavin Daily Brief">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_daily_brief_info" />
        </receiver>
        <receiver android:name=".widget.CreatorInsightsWidgetProvider" android:exported="false" android:label="FrameByNavin Creator Insights">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_insights_info" />
        </receiver>

        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTop" android:theme="@style/Theme.FrameByNavin.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
